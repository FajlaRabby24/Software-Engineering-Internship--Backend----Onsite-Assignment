model User {
  id              String  @id @default(uuid())
  name            String
  email           String  @unique
  password        String
  role            Role    @default(USER)
  isActive        Boolean @default(true)
  isEmailVerified Boolean @default(false)
  phoneNumber     String?
  avatarUrl       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]

  @@index([email])
  @@map("users")
}
