model AIProvider {
  id        String         @id @default(uuid())
  name      String
  type      AIProviderType
  apiKey    String
  baseUrl   String?
  models    String[]
  isActive  Boolean        @default(true)
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("ai_providers")
}
