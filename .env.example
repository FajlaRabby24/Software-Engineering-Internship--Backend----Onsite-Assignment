# Server Configuration
PORT=3000

# PostgreSQL Connection String (e.g. Neon, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/ai_saas_db?sslmode=prefer"

# JWT Authentication
JWT_ACCESS_SECRET="replace-with-a-secure-32-char-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="replace-with-a-secure-32-char-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# AES-256 Encryption Key for AI Provider API keys (must be exactly 32 chars)
ENCRYPTION_KEY="replace-with-a-32-char-enc-key!"
